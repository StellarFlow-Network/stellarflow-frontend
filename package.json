{
  "name": "stellarflow-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-pwa-icons.js && next build --webpack && node scripts/check-bundle-size.js",
    "build:export": "node scripts/build-static-export.js",
    "build:analyze": "ANALYZE=true next build",
    "build:strict": "node scripts/check-sri.js && next build --webpack && node scripts/check-bundle-size.js --strict && node scripts/check-css-size.js --strict",
    "build-storybook": "storybook build",
    "start": "next start",
    "lint": "eslint",
"test": "node scripts/test-lang-cache.js && node scripts/test-yield-benchmark.js",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:coverage": "node scripts/check-component-coverage.mjs",
    "test:storage": "node scripts/test-storage.js && node scripts/test-storage-sanitizer.js",
    "test:e2e": "playwright test",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "check:links": "node scripts/check-broken-links.js",
    "check:hydration": "node scripts/check-hydration.js",
    "analyze": "cross-env ANALYZE=true npm run build",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@creit.tech/xbull-wallet-connect": "^0.4.0",
    "@ledgerhq/hw-app-str": "^7.0.3",
    "@ledgerhq/hw-transport-webusb": "^6.29.6",
    "@sentry/nextjs": "^10.69.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.0.1",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-persist-client": "^5.100.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/leaflet": "^1.9.21",
    "@types/ws": "^8.18.1",
    "@zxing/library": "^0.21.3",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.14",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "isomorphic-dompurify": "^3.19.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.3",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-grid-layout": "^2.2.4",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "ws": "^8.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.0.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-links": "^10.5.5",
    "@storybook/nextjs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "cypress": "^14.5.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "webpack-bundle-analyzer": "^4.9.0"
  }
}
